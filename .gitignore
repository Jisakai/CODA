# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode / Swift (project is generated by XcodeGen, never committed)
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
.build/
.swiftpm/
*.xcresult/

# Local IDE state
.idea/
.vscode/

# Build outputs
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM/
*.log

# Python (chord predictor training)
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Training data and checkpoints (large, re-downloadable)
data/
datasets/
checkpoints/
*.pt
*.pth

# Downloaded at runtime on the iPad, never in the repo
models/
*.safetensors
*.gguf

